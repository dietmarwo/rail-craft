new file mode 100644
index 0000000..a567506
--- /dev/null
+++ b/examples/python/closure_scenarios.py
@@ -0,0 +1,55 @@
+"""Application: how much does a maintenance closure cost, and which policy copes best?
+
+Scenario comparison on a 16-train corridor. A closure of the central block starts at tick
+12 and lasts 0 to 30 ticks; one further scenario slows every central-block run by one tick.
+Four dispatch policies are evaluated in each scenario with full records, so the study can
+report lateness, the worst delay and each policy's regret against the scenario's best. A
+traced replay then shows central-block occupancy around the longest closure, and a short
+horizon shows how an unfinished schedule is classified.
+"""
+
+from corridor import CENTRAL, corridor
+from rail_craft import Prepared
+
+policies = {"fifo": [0, 1], "priority": [1, 0], "balanced": [4, 1], "tuned": [4, 0.25]}
+scenarios = {
+    "no closure": corridor(trains=16),
+    "closure 10": corridor(trains=16, closures=[(12, 22)]),
+    "closure 20": corridor(trains=16, closures=[(12, 32)]),
+    "closure 30": corridor(trains=16, closures=[(12, 42)]),
+    "slow block": corridor(trains=16, block_run=5),
+}
+
+print(f"{'scenario':12s} {'policy':9s} {'weighted':>9s} {'max':>4s} {'mean':>6s} {'regret':>7s}")
+totals = dict.fromkeys(policies, 0.0)
+for label, model in scenarios.items():
+    prepared = Prepared(model)
+    candidates = [{"id": name, "parameters": w} for name, w in policies.items()]
+    records = prepared.batch(candidates, workers=2)["records"]
+    assert all(r["status"] == "complete" for r in records), records
+    best = min(r["score"] for r in records)
+    for r in records:
+        delays = r["metrics"]["delays"]
+        totals[r["id"]] += r["score"]
+        print(f"{label:12s} {r['id']:9s} {r['score']:9.0f} {r['metrics']['max_delay']:4d} "
+              f"{sum(delays) / len(delays):6.2f} {r['score'] - best:7.0f}")
+print("\ntotal weighted delay over all scenarios")
+for name, total in sorted(totals.items(), key=lambda item: item[1]):
+    print(f"  {name:9s} {total:7.0f}")
+
+# Central-block occupancy for the tuned policy around the 30-tick closure.
+replay = Prepared(scenarios["closure 30"]).evaluate(policies["tuned"], trace=True)
+names = [t["name"] for t in scenarios["closure 30"]["trains"]]
+rows = sorted((i for i in replay["metrics"]["intervals"] if i["resource"] == CENTRAL),
+              key=lambda i: i["entry"])
+print("\ncentral block, closure [12, 42), tuned policy ('=' service, '-' held after service)")
+for i in rows[:10]:
+    bar = " " * i["entry"] + "=" * (i["service_end"] - i["entry"]) + "-" * (i["exit"] - i["service_end"])
+    print(f"  {names[i['train']]} {i['entry']:3d}-{i['exit']:3d} |{bar}")
+
+# A horizon shorter than the makespan leaves the schedule unfinished.
+short = Prepared(corridor(trains=16, horizon=60))
+row = short.evaluate(policies["tuned"], trace=True)
+print(f"\nhorizon 60: status {row['status']}, detail {row['detail']}, "
+      f"completed {row['metrics']['completed']} of 16 by tick {row['metrics']['time']}, "
+      f"{len(row['metrics']['active'])} trains still holding a resource")
diff --git a/examples/python/corridor.py b/examples/python/corridor.py
new file mode 100644
index 0000000..93cfe4a
--- /dev/null
+++ b/examples/python/corridor.py
@@ -0,0 +1,75 @@
+"""Synthetic corridor models shared by the Python examples.
+
+The corridor has one capacity-one central block shared by eastbound and westbound trains.
+Each direction enters through its own siding and leaves through its own platform, so
+routes cannot form a circular wait. Times are abstract integer ticks.
+"""
+
+PRIORITIES = (0, 1, 3, 0, 2, 4)
+SIDING, PLATFORM = 1, 2
+WEST_SIDING, EAST_SIDING, CENTRAL, EAST_PLATFORM, WEST_PLATFORM = range(5)
+
+
+def corridor(trains=12, *, block_run=4, clearance=1, headway=3, slack=4,
+             closures=(), horizon=400):
+    """Return a model JSON object with `trains` alternating eastbound and westbound trains.
+
+    Pairs of opposing trains are released every `headway` ticks. A train's planned arrival
+    is its unobstructed run time plus `slack`. `closures` is a list of `(start, end)` tick
+    pairs for the central block.
+    """
+    resources = [{"name": name, "clearance": clearance} for name in
+                 ("west siding", "east siding", "central block", "east platform", "west platform")]
+    rows = []
+    for i in range(trains):
+        east = i % 2 == 0
+        release = headway * (i // 2) + i % 2
+        route = [
+            {"resource": WEST_SIDING if east else EAST_SIDING, "duration": SIDING},
+            {"resource": CENTRAL, "duration": block_run},
+            {"resource": EAST_PLATFORM if east else WEST_PLATFORM, "duration": PLATFORM},
+        ]
+        rows.append({
+            "name": f"{'E' if east else 'W'}{i:02d}",
+            "release": release,
+            "planned": release + SIDING + block_run + PLATFORM + slack,
+            "priority": PRIORITIES[i % len(PRIORITIES)],
+            "route": route,
+        })
+    return {
+        "horizon": horizon,
+        "resources": resources,
+        "trains": rows,
+        "closures": [{"resource": CENTRAL, "start": s, "end": e} for s, e in closures],
+    }
+
+
+LOOP_NAMES = ("west entry", "block A", "loop east", "loop west", "block B", "east exit",
+              "east entry", "west exit")
+
+
+def passing_loop(trains=8, *, headway=6, run=3, loop=2, slack=6, offset=1, horizon=400,
+                 priorities=(2, 0, 1, 3, 0, 1)):
+    """Return a single-track line with one passing loop.
+
+    Eastbound trains run west entry, block A, loop east, block B, east exit; westbound
+    trains run east entry, block B, loop west, block A, west exit. The greedy dispatcher
+    has no look-ahead: if it lets opposing trains fill both blocks and both loop tracks,
+    the four trains wait on each other and the schedule deadlocks. Which train wins a
+    contended block depends on the dispatch weights.
+    """
+    resources = [{"name": name, "clearance": 1} for name in LOOP_NAMES]
+    rows = []
+    for i in range(trains):
+        east = i % 2 == 0
+        release = headway * (i // 2) + (i % 2) * offset
+        legs = ([(0, 1), (1, run), (2, loop), (4, run), (5, 1)] if east
+                else [(6, 1), (4, run), (3, loop), (1, run), (7, 1)])
+        rows.append({
+            "name": f"{'E' if east else 'W'}{i:02d}",
+            "release": release,
+            "planned": release + sum(d for _, d in legs) + slack,
+            "priority": priorities[i % len(priorities)],
+            "route": [{"resource": r, "duration": d} for r, d in legs],
+        })
+    return {"horizon": horizon, "resources": resources, "trains": rows, "closures": []}
diff --git a/examples/python/optimize_fcmaes_bite.py b/examples/python/optimize_fcmaes_bite.py
new file mode 100644
index 0000000..570b727
--- /dev/null
+++ b/examples/python/optimize_fcmaes_bite.py
@@ -0,0 +1,54 @@
+"""Optimization with fcmaes: BiteOpt with failure penalties for deadlocking policies.
+
+A dispatch policy must serve two lines: the 16-train corridor, and a single-track line with
+one passing loop where the greedy dispatcher deadlocks if it lets opposing trains fill both
+blocks and both loop tracks. `fcmaes.bitecpp.minimize` calls a scalar objective; each call
+scores one row on both lines with `score_matrix`. A deadlock (status `infeasible`) gets a
+penalty, so the search must trade corridor lateness for a policy that never deadlocks.
+"""
+
+import numpy as np
+from loguru import logger
+from scipy.optimize import Bounds
+
+from fcmaes import bitecpp
+from corridor import corridor, passing_loop
+from rail_craft import Prepared
+
+logger.remove()
+PENALTY = 1e5
+line = Prepared(corridor(trains=16))
+loop = Prepared(passing_loop())
+calls = deadlocks = 0
+
+
+def objective(x):
+    global calls, deadlocks
+    calls += 1
+    total = 0.0
+    for prepared in (line, loop):
+        scores, statuses, _ = prepared.score_matrix([x])
+        if statuses[0] != "complete":
+            deadlocks += 1
+            return PENALTY + total
+        total += scores[0]
+    return total
+
+
+result = bitecpp.minimize(objective, bounds=Bounds([0.0, 0.0], [10.0, 10.0]), x0=[5.0, 5.0],
+                          max_evaluations=1500, rg=np.random.Generator(np.random.PCG64DXSM(3)))
+x = result.x
+print(f"BiteOpt: combined weighted delay {result.fun:.0f} at [{x[0]:.3f}, {x[1]:.3f}] "
+      f"({calls} calls, {deadlocks} penalized deadlocks)")
+for label, prepared in (("corridor", line), ("passing loop", loop)):
+    row = prepared.evaluate(list(x))
+    print(f"  {label:12s} status {row['status']}, score {row['score']:.0f}")
+
+corridor_best = [4.0, 0.25]
+row = loop.evaluate(corridor_best, trace=True)
+print(f"\ncorridor-only optimum {corridor_best}: corridor score "
+      f"{line.evaluate(corridor_best)['score']:.0f}, passing loop {row['status']} ({row['detail']})")
+names = [t["name"] for t in passing_loop()["trains"]]
+print(f"  deadlock at tick {row['metrics']['time']} after {row['metrics']['completed']} arrivals; held:")
+for held in row["metrics"]["active"]:
+    print(f"    {names[held['train']]} holds resource {held['resource']} (leg {held['leg']})")
diff --git a/examples/python/optimize_fcmaes_cmaes.py b/examples/python/optimize_fcmaes_cmaes.py
new file mode 100644
index 0000000..81d4c6b
--- /dev/null
+++ b/examples/python/optimize_fcmaes_cmaes.py
@@ -0,0 +1,49 @@
+"""Optimization with fcmaes: CMA-ES ask/tell over whole populations.
+
+Find dispatch weights that minimize the mean weighted delay over three closure scenarios
+of a 20-train corridor. `fcmaes.cmaes.Cmaes` proposes a population with `ask()`; each
+scenario scores the whole population in one `score_matrix` call on two native workers,
+and `tell()` receives the mean. Incomplete rows would be penalized.
+"""
+
+import numpy as np
+from loguru import logger
+from scipy.optimize import Bounds
+
+from fcmaes import cmaes
+from corridor import corridor
+from rail_craft import Prepared
+
+logger.remove()
+PENALTY = 1e6
+scenarios = [Prepared(corridor(trains=20, closures=c)) for c in ([(10, 20)], [(30, 45)], [(55, 60)])]
+bounds = Bounds([0.0, 0.0], [10.0, 10.0])
+es = cmaes.Cmaes(bounds=bounds, x0=np.array([5.0, 5.0]), input_sigma=2.5, popsize=16,
+                 rg=np.random.Generator(np.random.PCG64DXSM(5)))
+
+
+def population_score(xs):
+    total = np.zeros(len(xs))
+    for prepared in scenarios:
+        scores, statuses, _ = prepared.score_matrix(xs, workers=2)
+        ok = np.array([s == "complete" for s in statuses])
+        total += np.where(ok, scores, PENALTY)
+    return total / len(scenarios)
+
+
+best_y, best_x, generations = np.inf, None, 0
+for generations in range(1, 31):
+    xs = es.ask()
+    ys = population_score(xs)
+    if ys.min() < best_y:
+        best_y, best_x = float(ys.min()), xs[int(ys.argmin())]
+    if es.tell(ys) != 0:
+        break
+print(f"CMA-ES: mean weighted delay {best_y:.2f} at [{best_x[0]:.3f}, {best_x[1]:.3f}] "
+      f"after {generations} generations ({generations * 16} policies x {len(scenarios)} scenarios)")
+
+reference = population_score(np.array([[0, 1], [1, 0], [1, 1]]))
+for label, value in zip(("FIFO [0, 1]", "priority only [1, 0]", "equal [1, 1]"), reference, strict=True):
+    print(f"  {label:22s} mean weighted delay {value:.2f}")
+per_scenario = [p.score_matrix([best_x])[0][0] for p in scenarios]
+print(f"  best policy per scenario: {per_scenario}")
diff --git a/examples/python/optimize_scipy.py b/examples/python/optimize_scipy.py
new file mode 100644
index 0000000..e28826a
--- /dev/null
+++ b/examples/python/optimize_scipy.py
@@ -0,0 +1,58 @@
+"""Optimization with SciPy: vectorized differential evolution through `score_matrix`.
+
+Tune the two dispatch weights for a 16-train corridor with a 15-tick maintenance closure.
+`differential_evolution(vectorized=True)` hands the objective a whole population as a
+(2, S) array; one `score_matrix` call scores it on two native workers without JSON. Rows
+that are not complete would receive a large penalty. The result is compared with a dense
+grid search and checked on a held-out closure scenario.
+"""
+
+import numpy as np
+from scipy.optimize import differential_evolution
+
+from corridor import corridor
+from rail_craft import Prepared
+
+PENALTY = 1e6
+training = Prepared(corridor(trains=16, closures=[(20, 35)]))
+held_out = Prepared(corridor(trains=16, closures=[(40, 52)]))
+calls = rows = failures = 0
+
+
+def objective(population):
+    """Score a (2, S) population; incomplete rows get PENALTY."""
+    global calls, rows, failures
+    scores, statuses, _ = training.score_matrix(population.T, workers=2)
+    calls += 1
+    rows += len(statuses)
+    scores = np.array(scores)
+    failed = np.array([s != "complete" for s in statuses])
+    failures += int(failed.sum())
+    return np.where(failed, PENALTY, scores)
+
+
+result = differential_evolution(objective, bounds=[(0, 10), (0, 10)], vectorized=True,
+                                updating="deferred", popsize=12, maxiter=40, tol=0, seed=11,
+                                polish=False)
+print(f"differential evolution: weighted delay {result.fun:.0f} at "
+      f"[{result.x[0]:.3f}, {result.x[1]:.3f}]")
+print(f"  {result.nit} generations, {calls} native calls scored {rows} rows, {failures} penalized; "
+      f"{result.message}")
+
+# 61 x 61 = 3,721 rows fit in one call (the limit is 4,096 rows).
+grid = np.array([[p, a] for p in np.linspace(0, 10, 61) for a in np.linspace(0, 10, 61)])
+scores, _, _ = training.score_matrix(grid, workers=2)
+best = int(np.argmin(scores))
+print(f"61 x 61 grid search:    weighted delay {scores[best]:.0f} at {grid[best].tolist()}")
+
+checks = [result.x.tolist(), grid[best].tolist(), [0, 1], [1, 0]]
+held, _, _ = held_out.score_matrix(checks)
+print("\nheld-out closure [40, 52)")
+for label, weights, score in zip(("DE result", "grid best", "FIFO", "priority only"),
+                                 checks, held, strict=True):
+    print(f"  {label:13s} [{weights[0]:6.3f}, {weights[1]:6.3f}] -> {score:.0f}")
+
+replay = training.evaluate(result.x.tolist(), trace=True)
+assert replay["status"] == "complete" and replay["score"] == result.fun, replay
+print(f"\ntraced replay agrees: score {replay['score']:.0f}, steps {replay['steps']}, "
+      f"max delay {replay['metrics']['max_delay']}")
