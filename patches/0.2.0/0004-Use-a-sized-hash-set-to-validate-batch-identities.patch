Subject: [PATCH 04/12] Use a sized hash set to validate batch identities

---
 src/lib.rs | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/lib.rs b/src/lib.rs
index 030ffda..4648f35 100644
--- a/src/lib.rs
+++ b/src/lib.rs
@@ -5,7 +5,7 @@ use serde::{Deserialize, Serialize};
 use serde_json::{Value, json, value::RawValue};
 use sha2::{Digest, Sha256};
 use std::{
-    collections::BTreeSet,
+    collections::HashSet,
     path::PathBuf,
     sync::{
         OnceLock,
@@ -178,7 +178,7 @@ impl Prepared {
         {
             return Err("invalid budget or batch size".into());
         }
-        let mut seen = BTreeSet::new();
+        let mut seen = HashSet::with_capacity(candidates.len());
         for c in &candidates {
             if c.id.is_empty() || c.id.len() > 128 || !seen.insert(&c.id) || c.parameters.len() > 64
             {
